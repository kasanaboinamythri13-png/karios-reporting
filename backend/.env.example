# Copy this file to .env and fill in the values. Never commit .env.
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173
APP_TIMEZONE=Asia/Kolkata

# Database: Neon PostgreSQL connection string
DATABASE_URL=

# Firebase Admin (Project settings -> Service accounts -> Generate new private key)
# Easiest: npm run firebase:key -- "path\to\downloaded-key.json"  (fills the three lines below)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Not needed: attachments are stored in the database (npm run db:attachments)
FIREBASE_STORAGE_BUCKET=

# Test logins like "Bearer dev-finance" (local only — must be false on the live server)
ALLOW_DEV_TOKENS=false

# Daily reminder time (cron, IST) when running "npm run dev" / "npm start". Default: 18:00 every day
REMINDER_CRON=0 18 * * *

# Live server on Vercel only: any long random text. Vercel Cron sends it to /api/cron/daily-reminder.
CRON_SECRET=
