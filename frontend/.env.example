# Copy to .env (cp .env.example .env). Never commit .env.
# "/api" is forwarded to the backend (localhost:4000) by Vite locally, and by vercel.json on the live site.
VITE_API_URL=/api

# false = real Firebase login (needed for attachments). true = offline demo with fake data.
VITE_USE_MOCK_AUTH=false

# Firebase web config (Project settings -> General -> Your apps -> Web app).
# Not secrets — Firebase protects the project with "Authorized domains" + the backend checks.
VITE_FIREBASE_API_KEY=AIzaSyD69LLvJpqc5rVY4P74mDyaPZwauQGyIYk
VITE_FIREBASE_AUTH_DOMAIN=karios-reporting-a62df.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=karios-reporting-a62df
VITE_FIREBASE_STORAGE_BUCKET=karios-reporting-a62df.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=328742477959
VITE_FIREBASE_APP_ID=1:328742477959:web:d1d5d7c15dfcda4b7ed822

# Show the "continue as Developer/Sales/… Head" test buttons on the login page
# (local only; backend needs ALLOW_DEV_TOKENS=true)
VITE_SHOW_DEV_LOGIN=false
