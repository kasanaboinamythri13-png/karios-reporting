# Copy to .env and fill in. Never commit .env.
VITE_API_URL=http://localhost:4000/api
VITE_USE_MOCK_AUTH=true

# Firebase login (Project settings -> General -> Your apps -> Web app). APP_ID is optional.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Show the "continue as Developer/Sales/… Head" test buttons on the login page
# (local only; backend needs ALLOW_DEV_TOKENS=true)
VITE_SHOW_DEV_LOGIN=false
